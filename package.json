{
  "name": "boss-works-for-me",
  "version": "1.0.0",
  "private": true,
  "description": "《赛博小镇》— 3D 职场社交经营 RPG（演示版）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "go run ./cmd/boss-server",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "typecheck": "tsc -b",
    "start": "go run ./cmd/boss-server",
    "seed": "go run ./cmd/boss-server --seed",
    "reset": "go run ./cmd/boss-server --reset",
    "test": "npm run test:api && npm run test:web",
    "test:e2e": "npm run build && playwright test tea-town.spec.ts",
    "test:e2e:legacy": "npm run build && playwright test",
    "test:tea": "node scripts/check-tea-agent.ts",
    "demo:record": "node --disable-warning=ExperimentalWarning scripts/record-demo.ts",
    "build:web": "tsc -b && vite build",
    "build:server": "go build -trimpath -o bin/boss-server ./cmd/boss-server",
    "start:binary": "./bin/boss-server",
    "test:race": "go test -race ./...",
    "test:contract": "node scripts/check-rules.ts",
    "test:map": "node scripts/check-map-routes.ts",
    "test:collision": "node scripts/check-collision.ts",
    "test:arcade": "node scripts/check-arcade.ts",
    "perf:cpu": "node scripts/benchmark-cpu.ts",
    "test:render": "node scripts/check-render-budget.ts",
    "test:audio": "node scripts/check-audio.ts",
    "test:music": "node scripts/check-music.ts",
    "audio:preview": "node scripts/render-tea-music.ts",
    "test:web": "npm run typecheck && npm run test:contract && npm run test:transport && npm run test:proximity && npm run test:map && npm run test:collision && npm run test:render && npm run test:arcade && npm run test:audio && npm run test:music && npm run test:sync && npm run test:player-contract",
    "test:api": "go test ./...",
    "test:transport": "node scripts/check-transport.ts",
    "test:deployment": "node scripts/check-deployment.mjs",
    "test:proximity": "node scripts/check-proximity.ts",
    "test:sync": "node scripts/check-sync-queue.ts",
    "test:player-contract": "node scripts/export-player-contract.ts",
    "test:tea-town": "node scripts/check-tea-town.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "lucide-react": "^1.60.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "typescript": "5.9",
    "vite": "^7.3.7"
  }
}
