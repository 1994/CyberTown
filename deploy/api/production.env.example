# Consumed by the private executable using server.ConfigFromEnv + company SPI.
APP_ENV=production
HOST=0.0.0.0
PORT=8787
DB_PATH=/data/boss-production.db
STATIC_DIR=
ALLOW_DEMO_RESET=0
# Same-origin intranet reverse proxy: leave empty.
CORS_ALLOWED_ORIGINS=
LOGIN_CALLBACK_URL=https://game.example.internal/?boss_auth=callback
# Company endpoint and credentials are defined by your private adapter only.
# AUTH_MODE is not used by the private composition executable.
