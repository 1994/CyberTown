# 默认支持局域网；如只允许本机访问，改成 127.0.0.1。
HOST=0.0.0.0
PORT=8787
DB_PATH=data/boss.db
STATIC_DIR=dist
# 只在可丢弃的本地演示环境启用（无密码重置端点）。默认关闭。
ALLOW_DEMO_RESET=0
# demo 为原有体验身份；mock 仅用于本地身份接口联调（关闭测试身份入口）。
AUTH_MODE=demo
# AUTH_MODE=mock 时必须显式提供文件，示例：examples/identity/mock-users.json
MOCK_IDENTITIES_FILE=
# Environment boundary. Real deployment uses a PRIVATE company SPI executable.
APP_ENV=test
# Frontend dev proxy; not bundled into browser code. Only point public dev to test APIs.
# API_PROXY_TARGET=http://127.0.0.1:8787
# Direct cross-origin API/SSE: comma-separated exact origins; empty = same origin.
CORS_ALLOWED_ORIGINS=
# Only used by identity.BrowserProvider (implemented privately inside intranet).
LOGIN_CALLBACK_URL=
